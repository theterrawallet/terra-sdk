# Copy to .env.local. Never commit .env.local.

# Server only: your Terra secret key (dashboard.terrawallet.us > Project > API keys). Never expose it to the browser.
TERRA_SECRET_KEY=tw_test_sk_replace_me
# Server only: the signing secret shown once when you create the webhook endpoint.
TERRA_WEBHOOK_SECRET=whsec_replace_me

# Browser safe: publishable key, locked to your allowed origins in the dashboard.
NEXT_PUBLIC_TERRA_PUBLISHABLE_KEY=tw_test_pk_replace_me
# Browser safe: WalletConnect (Reown) project id for the QR / app deep-link fallback. Free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
