{
  "name": "@terrawallet/elements",
  "version": "0.1.0",
  "description": "Terra Wallet Web Components: <terra-connect-button> and <terra-pay-button>, rendered in a closed Shadow DOM. One script tag with an SRI hash, or an ES module.",
  "keywords": [
    "terra-wallet",
    "terra-pay",
    "wallet",
    "web3",
    "crypto-payments"
  ],
  "homepage": "https://developers.terrawallet.us/docs",
  "bugs": {
    "url": "https://github.com/theterrawallet/terra-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theterrawallet/terra-sdk.git",
    "directory": "packages/elements"
  },
  "license": "Apache-2.0",
  "author": "Terra Wallet (https://terrawallet.us)",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./dist/cdn/*"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./cdn/manifest.json": "./dist/cdn/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "sbom": "node ../../scripts/sbom.mjs ."
  },
  "dependencies": {
    "@terrawallet/connect": "workspace:*",
    "@terrawallet/pay-js": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@walletconnect/sign-client": "2.23.9",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "qrcode.react": "4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
