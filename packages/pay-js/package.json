{
  "name": "@terrawallet/pay-js",
  "version": "0.1.0",
  "description": "Open Terra Pay hosted checkout (pay.terrawallet.us) in a popup or a sandboxed modal, with origin-checked callbacks and a subscribe button.",
  "keywords": [
    "terra-wallet",
    "terra-pay",
    "wallet",
    "web3",
    "crypto-payments"
  ],
  "homepage": "https://developers.terrawallet.us/docs",
  "bugs": {
    "url": "https://github.com/theterrawallet/terra-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theterrawallet/terra-sdk.git",
    "directory": "packages/pay-js"
  },
  "license": "Apache-2.0",
  "author": "Terra Wallet (https://terrawallet.us)",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "sbom": "node ../../scripts/sbom.mjs ."
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.1",
    "happy-dom": "21.0.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
